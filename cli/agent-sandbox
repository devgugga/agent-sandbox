#!/usr/bin/env bash
# cli/agent-sandbox — ponto de entrada do host
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/cli/lib/pod.sh"
source "$ROOT/cli/lib/auth.sh"
source "$ROOT/cli/lib/attach.sh"

usage() {
  cat >&2 <<'USAGE'
uso:
  agent-sandbox up   --workspace <id> --repo <caminho>
  agent-sandbox down --workspace <id>
  agent-sandbox auth
USAGE
  exit 2
}

cmd="${1:-}"; shift || usage
ws=""; repo=""
while [ $# -gt 0 ]; do
  case "$1" in
    --workspace) ws="${2:-}"; shift 2 ;;
    --repo)      repo="${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done

check_ws() {
  case "$ws" in
    ''|*[!a-zA-Z0-9._-]*) echo "workspace invalido: use apenas [a-zA-Z0-9._-]" >&2; exit 2 ;;
  esac
}

case "$cmd" in
  up)   check_ws
        [ -d "$repo" ] || { echo "repo inexistente: $repo" >&2; exit 2; }
        asb_up "$ws" "$(cd "$repo" && pwd)" ;;
  down) check_ws
        asb_down "$ws" ;;
  prune)
        # Reapa pods de sandbox orfaos. Necessario porque um destroy que erre o
        # nome do workspace deixa o pod rodando em silencio, e o Orca reporta
        # sucesso mesmo assim.
        n=0
        for p in $(podman pod ls --format '{{.Name}}' | grep '^asb-' || true); do
          podman pod rm -f "$p" >/dev/null 2>&1 && { echo "removido: $p" >&2; n=$((n+1)); }
        done
        echo "$n pod(s) de sandbox removido(s)" >&2 ;;
  auth) asb_auth ;;
  install-guards)
        # Instala os nomes que vao no campo "Command" do Orca.
        mkdir -p "$HOME/.local/bin"
        for a in claude codex agy; do
          ln -sf "$ROOT/cli/asb-agent" "$HOME/.local/bin/asb-$a"
          echo "instalado: ~/.local/bin/asb-$a" >&2
        done
        echo "Agora, em Orca -> Settings -> Agents, troque o campo Command:" >&2
        echo "  claude -> asb-claude | codex -> asb-codex | agy -> asb-agy" >&2 ;;
  *)    usage ;;
esac
