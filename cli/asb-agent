#!/usr/bin/env python3
"""cli/asb-agent — ponto de entrada do host.

Roda direto do checkout: sem instalacao, sem dependencias, sem passo de build.
Este arquivo faz APENAS parsing e despacho; toda a logica vive em cli/asb/.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from asb import install, lifecycle, supervisor  # noqa: E402
from asb.auth import login as auth_login  # noqa: E402
from asb.auth import status as auth_status  # noqa: E402
from asb.auth import verify as auth_verify  # noqa: E402
from asb.doctor import doctor  # noqa: E402
from asb.podman import PodmanError  # noqa: E402
from asb.profile import ProfileError  # noqa: E402
from asb.workspace import WorkspaceError  # noqa: E402

ROOT = Path(__file__).resolve().parent.parent


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="asb-agent",
        description="Sandbox de execucao isolado para agentes de IA.")
    sub = parser.add_subparsers(dest="command", required=True)

    def workspace_command(name: str, help_text: str):
        cmd = sub.add_parser(name, help=help_text)
        cmd.add_argument("--workspace", required=True)
        return cmd

    up = workspace_command("up", "cria e sobe um workspace")
    up.add_argument("--repo", required=True)
    up.add_argument(
        "--runtime",
        choices=["legacy", "systemd"],
        default="legacy",
        help="backend de supervisao (default: legacy)",
    )

    workspace_command("down", "remove containers e rede; preserva o trabalho")
    workspace_command("suspend", "para os containers do workspace")
    workspace_command("resume", "religa os containers do workspace")
    workspace_command("reload-allowlist", "recarrega a allowlist do proxy sem tocar no agente")
    workspace_command("pull", "traz o branch do workspace para o checkout")

    purge = workspace_command("purge", "remove tambem os arquivos do workspace")
    purge.add_argument("--yes", action="store_true",
                       help="confirma a remocao dos arquivos")

    sub.add_parser("build", help="constroi a imagem base")
    login_parser = sub.add_parser(
        "login", help="autentica um fornecedor (default: todos), uma vez")
    login_parser.add_argument(
        "--agent", choices=["claude", "codex", "agy", "all"], default="all",
        help="fornecedor a autenticar (default: all)")

    auth_parser = sub.add_parser("auth", help="status de conta por fornecedor (diagnostico)")
    auth_sub = auth_parser.add_subparsers(dest="auth_command", required=True)
    auth_status_parser = auth_sub.add_parser(
        "status", help="consulta status de conta (nunca inicia login)")
    auth_status_parser.add_argument("--workspace", required=True)
    auth_status_parser.add_argument(
        "--agent", choices=["claude", "codex", "agy", "all"], default="all")
    auth_status_parser.add_argument(
        "--json", action="store_true", dest="as_json",
        help="emite relatorio em formato JSON schema 1")

    auth_verify_parser = auth_sub.add_parser(
        "verify",
        help="chamada REAL ao fornecedor (orcamento: 1 por fornecedor, sem retry)")
    auth_verify_parser.add_argument("--workspace", required=True)
    auth_verify_parser.add_argument(
        "--agent", choices=["claude", "codex", "agy", "all"], default="all")
    auth_verify_parser.add_argument(
        "--json", action="store_true", dest="as_json",
        help="emite relatorio em formato JSON schema 1")

    doc_parser = sub.add_parser("doctor", help="diagnostica o ambiente")
    doc_parser.add_argument("--json", action="store_true", dest="as_json", help="emite diagnostico em formato JSON schema 1")
    sub.add_parser("list", help="lista os workspaces conhecidos")
    sub.add_parser("install-guards", help="instala asb-claude/codex/agy")
    sub.add_parser("install-broker", help="instala o broker do Docker (sudo)")

    adopt_parser = sub.add_parser(
        "adopt-runtime", help="adota supervisao systemd sem recriar containers")
    adopt_target = adopt_parser.add_mutually_exclusive_group(required=True)
    adopt_target.add_argument("--workspace", help="ID do workspace a adotar")
    adopt_target.add_argument("--keyring", action="store_true", help="adotar servico singleton de keyring")
    adopt_parser.add_argument(
        "--apply", action="store_true",
        help="aplica alteracoes (default: inventario/dry-run)")
    adopt_parser.add_argument(
        "--json", action="store_true", dest="as_json",
        help="emite resultado em formato JSON")

    rollback_parser = sub.add_parser(
        "rollback-runtime", help="reverte supervisao systemd para legado sem recriar containers")
    rollback_target = rollback_parser.add_mutually_exclusive_group(required=True)
    rollback_target.add_argument("--workspace", help="ID do workspace a reverter")
    rollback_target.add_argument("--keyring", action="store_true", help="reverter servico singleton de keyring")
    rollback_parser.add_argument(
        "--json", action="store_true", dest="as_json",
        help="emite resultado em formato JSON")

    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        if args.command == "build":
            return lifecycle.build(ROOT)
        if args.command == "auth":
            if args.auth_command == "status":
                return auth_status(
                    args.workspace, args.agent, json_output=args.as_json)
            if args.auth_command == "verify":
                return auth_verify(
                    args.workspace, args.agent, json_output=args.as_json)
        if args.command == "up":
            return lifecycle.up(
                ROOT,
                args.workspace,
                Path(args.repo).resolve(),
                runtime=args.runtime,
            )
        if args.command == "down":
            return lifecycle.down(args.workspace)
        if args.command == "suspend":
            return lifecycle.suspend(args.workspace)
        if args.command == "resume":
            return lifecycle.resume(ROOT, args.workspace)
        if args.command == "reload-allowlist":
            return lifecycle.reload_allowlist(ROOT, args.workspace)
        if args.command == "pull":
            return lifecycle.pull(args.workspace)
        if args.command == "purge":
            return lifecycle.purge(args.workspace, confirmed=args.yes)
        if args.command == "login":
            return auth_login(ROOT, args.agent)
        if args.command == "list":
            return lifecycle.list_workspaces()
        if args.command == "doctor":
            return doctor(ROOT, as_json=getattr(args, "as_json", False))
        if args.command == "install-guards":
            return install.guards(ROOT)
        if args.command == "install-broker":
            return install.broker(ROOT)
        if args.command == "adopt-runtime":
            if getattr(args, "workspace", None):
                res = supervisor.adopt_workspace(
                    args.workspace,
                    apply=args.apply,
                )
                if getattr(args, "as_json", False):
                    print(json.dumps(res, indent=2))
                else:
                    if res.get("status") == "dry_run":
                        c_count = len((res.get("inventory") or {}).get("containers", {}))
                        print(f"dry-run concluido para workspace '{args.workspace}': {c_count} container(s) inventariado(s)")
                    else:
                        print(f"workspace '{args.workspace}' adotado sob supervisao systemd (fase: {res.get('phase')})")
            elif getattr(args, "keyring", False):
                res = supervisor.adopt_keyring(
                    apply=args.apply,
                )
                if getattr(args, "as_json", False):
                    print(json.dumps(res, indent=2))
                else:
                    if res.get("status") == "dry_run":
                        print("dry-run concluido para keyring: 1 container inventariado")
                    else:
                        print(f"keyring adotado sob supervisao systemd (fase: {res.get('phase')})")
            else:
                print("asb-agent: especifique --workspace ID ou --keyring", file=sys.stderr)
                return 2
            return 0
        if args.command == "rollback-runtime":
            if getattr(args, "workspace", None):
                res = supervisor.rollback_workspace(
                    args.workspace,
                )
                if getattr(args, "as_json", False):
                    print(json.dumps(res, indent=2))
                else:
                    print(f"workspace '{args.workspace}' revertido com sucesso para runtime legado")
            elif getattr(args, "keyring", False):
                res = supervisor.rollback_keyring()
                if getattr(args, "as_json", False):
                    print(json.dumps(res, indent=2))
                else:
                    print("keyring revertido com sucesso para runtime legado")
            else:
                print("asb-agent: especifique --workspace ID ou --keyring", file=sys.stderr)
                return 2
            return 0
    except (ValueError, FileNotFoundError, RuntimeError) as error:
        print(f"asb-agent: {error}", file=sys.stderr)
        return 2
    except PodmanError as error:
        # 2, e nao 1: em todo este CLI 1 significa "conta ausente" e 2
        # significa "infraestrutura", com 2 tendo precedencia (asb-agent auth
        # status, asb-agent login, doctor). `PodmanError` e sempre
        # infraestrutura — podman ausente, volume que nao inspeciona, imagem
        # faltando —, e reporta-la como 1 mandava o operador procurar login
        # onde o problema era o podman.
        print(f"asb-agent: {error}", file=sys.stderr)
        return 2
    except (ProfileError, WorkspaceError) as error:
        print(f"asb-agent: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 2


if __name__ == "__main__":
    os.umask(0o077)
    sys.exit(main())
