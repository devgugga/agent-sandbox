# image/Containerfile — imagem base do agente.
#
# ASB_USER e ASB_HOME espelham o usuario do HOST. Sao build args, nunca
# literais: um nome de usuario assado aqui quebraria a imagem no primeiro host
# diferente, e o sintoma seriam caminhos que nao batem (spec §16).
FROM debian:bookworm-slim

ARG ASB_USER
ARG ASB_HOME
ENV DEBIAN_FRONTEND=noninteractive

RUN test -n "$ASB_USER" && test -n "$ASB_HOME" \
    || (echo "ASB_USER e ASB_HOME sao obrigatorios" >&2; exit 1)

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git openssh-server ripgrep jq socat \
      netcat-openbsd python3 build-essential procps less nano bubblewrap \
      gnome-keyring libsecret-tools dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code @openai/codex \
    && npm cache clean --force

RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/githubcli.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Ferramentas de contexto do agente. Versoes FIXAS de proposito: um build nao
# determinista deixaria um release quebrado entrar sem aviso, que e o modo de
# falha que este projeto existe para eliminar (spec §16). O `doctor` compara
# estes valores com os do host e avisa quando defasarem.
ARG UV_VERSION=0.12.10
ARG RTK_VERSION=0.46.0
ARG GRAPHIFY_VERSION=0.9.51

# Tudo em /usr/local/bin, NUNCA em ~/.local/bin ou ~/.local/share: o
# entrypoint recicla parte do home a cada arranque para montar o
# asb-toolcache, e ferramenta de sistema nao pode depender de um caminho que
# e apagado e relinkado.
RUN curl -fsSL "https://astral.sh/uv/${UV_VERSION}/install.sh" \
      | env UV_INSTALL_DIR=/usr/local/bin sh

# UV_TOOL_DIR so aqui, nao como ENV: o entrypoint faz
# `rm -rf ~/.local/share/uv` antes de linkar o volume, e esse e exatamente o
# default do `uv tool install` — instalar ali apagaria o graphify no primeiro
# arranque, com o sintoma "graphify nao existe" sem pista da causa. Em runtime
# a variavel fica desligada, para que um `uv tool install` do agente caia no
# toolcache persistente, que e onde ele deve cair.
# UV_PYTHON_DOWNLOADS=never usa o python3.11 do sistema (graphify pede >=3.10)
# em vez de baixar um interpretador para dentro do home reciclado.
RUN UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin \
    UV_PYTHON_DOWNLOADS=never \
      uv tool install "graphifyy==${GRAPHIFY_VERSION}"

# O install.sh do rtk tambem tem ~/.local/bin como default; RTK_INSTALL_DIR o
# tira de la. A tag do release leva "v", a versao reportada por `rtk --version`
# nao — o label guarda a forma sem "v" para bater com a comparacao do doctor.
RUN curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh \
      -o /tmp/rtk-install.sh \
    && RTK_VERSION="v${RTK_VERSION}" RTK_INSTALL_DIR=/usr/local/bin \
       sh /tmp/rtk-install.sh \
    && rm -f /tmp/rtk-install.sh

# A telemetria do rtk ja e opt-in e a allowlist a bloquearia; a variavel torna
# a intencao explicita em vez de depender do default alheio.
ENV RTK_TELEMETRY_DISABLED=1

LABEL asb.rtk.version="${RTK_VERSION}" \
      asb.graphify.version="${GRAPHIFY_VERSION}"

# O usuario espelha o do host: mesmo nome, uid 1000, MESMO home. E o home
# identico que faz a worktree irma do Orca cair num caminho que existe dos
# dois lados.
RUN useradd -m -u 1000 -d "$ASB_HOME" -s /bin/bash "$ASB_USER"

USER $ASB_USER
ENV HOME=$ASB_HOME
RUN curl -fsSL https://mise.run | sh
ENV PATH="/usr/local/sbin:/usr/sbin:/sbin:$ASB_HOME/.local/bin:$ASB_HOME/.local/share/mise/shims:${PATH}"
# O Antigravity CLI substituiu o Gemini CLI, descontinuado em 2026-06-18 para
# contas Pro/Ultra. E um binario Go unico; nao ha pacote npm.
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash
USER root

# HOST KEYS ASSADAS NO BUILD. Geradas em runtime, cada workspace teria a sua, e
# como todos atendem em 127.0.0.1 o ssh do Orca acusaria host-key-changed a
# cada workspace novo.
RUN ssh-keygen -A && mkdir -p /run/sshd

RUN printf '%s\n' \
      'PermitRootLogin no' \
      'PasswordAuthentication no' \
      'PubkeyAuthentication yes' \
      "AuthorizedKeysFile $ASB_HOME/.ssh/authorized_keys" \
      'AcceptEnv HTTPS_PROXY HTTP_PROXY NO_PROXY' \
      > /etc/ssh/sshd_config.d/agent-sandbox.conf

# NAO definir CLAUDE_CODE_SUBPROCESS_ENV_SCRUB aqui, nem em lugar algum. Ela
# protegia subprocessos NO HOST; dentro do container nao protege nada e o
# Claude Code responde a ela forcando o permission mode para default, anulando
# o --dangerously-skip-permissions que o Orca aplica.

# Marcador que o guarda procura para saber que esta DENTRO do sandbox. A
# ausencia dele no host e o que faz o guarda recusar la.
RUN printf 'agent-sandbox\n' > /etc/agent-sandbox-release

# Runtime de containers DENTRO do sandbox (spec §6.2). As configuracoes
# abaixo nao sao opcionais: sem elas o podman aninhado falha com
# "newuidmap: write to uid_map failed: Operation not permitted" — medido.
RUN apt-get update && apt-get install -y --no-install-recommends \
      podman podman-compose fuse-overlayfs uidmap passt slirp4netns netavark aardvark-dns iptables libcap2-bin \
    && rm -rf /var/lib/apt/lists/*

# 1) subuid/subgid para o usuario: dentro do namespace de keep-id do host
# (uid 1000), os uids disponiveis sao 1..999 e 1001..64535. newuidmap/newgidmap
# precisam de file capability cap_setuid/cap_setgid em vez de setuid-root,
# pois o kernel ignora o bit suid dentro de user namespaces nao privilegiados.
RUN printf '%s:1:999\n%s:1001:64535\n' "$ASB_USER" "$ASB_USER" > /etc/subuid \
    && printf '%s:1:999\n%s:1001:64535\n' "$ASB_USER" "$ASB_USER" > /etc/subgid \
    && chmod u-s /usr/bin/newuidmap /usr/bin/newgidmap \
    && setcap cap_setuid=ep /usr/bin/newuidmap \
    && setcap cap_setgid=ep /usr/bin/newgidmap

# 2) overlay via fuse-overlayfs: o driver overlay do kernel nao esta disponivel
#    para um usuario sem privilegio dentro de outro container.
RUN mkdir -p /etc/containers && printf '%s\n' \
      '[storage]' \
      'driver = "overlay"' \
      'runroot = "/run/containers/storage"' \
      'graphroot = "/var/lib/containers/storage"' \
      '[storage.options.overlay]' \
      'mount_program = "/usr/bin/fuse-overlayfs"' \
      'mountopt = "nodev,fsync=0"' \
      > /etc/containers/storage.conf

# 3) cgroupfs, crun, log em arquivo, utsns=host e default_sysctls vazio:
#    sem systemd nem sessao dbus de usuario aqui. utsns=host evita falha de
#    sethostname sem root; default_sysctls=[] evita falha em sysctl read-only.
RUN printf '%s\n' \
      '[containers]' \
      'utsns = "host"' \
      'default_sysctls = []' \
      '[engine]' \
      'cgroup_manager = "cgroupfs"' \
      'events_logger = "file"' \
      'runtime = "crun"' \
      > /etc/containers/containers.conf

# 4) registries explicitos: sem isso um `podman run alpine` fica ambiguo e o
#    podman recusa em vez de escolher.
RUN printf '%s\n' \
      'unqualified-search-registries = ["docker.io"]' \
      > /etc/containers/registries.conf

# 5) runner de compose (suporte a BlackICE e compose.yml):
#    O podman 4.3 do Debian nao tem o subcomando `compose` embutido (veio no 4.7+).
#    O wrapper em /usr/local/bin intercepta `podman compose` e repassa para o
#    podman-compose nativo do Bookworm, mantendo compatibilidade total.
RUN printf '%s\n' \
      '#!/usr/bin/env bash' \
      'if [ "${1:-}" = "compose" ]; then' \
      '    shift' \
      '    exec /usr/bin/podman-compose "$@"' \
      'fi' \
      'exec /usr/bin/podman "$@"' \
      > /usr/local/bin/podman \
    && chmod 0755 /usr/local/bin/podman \
    && ln -sf /usr/bin/podman-compose /usr/local/bin/docker-compose

# Contexto de build e a RAIZ do repositorio, para que exista uma unica copia
# do guarda. No v1 ele vivia em cli/ e em image/, e duas copias do mesmo
# programa divergem — de forma invisivel ate o agente se comportar diferente
# dentro e fora do sandbox.
COPY cli/asb-guard /usr/local/bin/asb-guard
RUN chmod 0755 /usr/local/bin/asb-guard \
    && for a in claude codex agy; do \
         ln -sf /usr/local/bin/asb-guard "/usr/local/bin/asb-$a"; \
       done

COPY image/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY image/start-keyring.sh /usr/local/bin/start-keyring.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/start-keyring.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
