# image/Containerfile
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git openssh-server ripgrep jq socat netcat-openbsd \
      python3 build-essential procps less nano bubblewrap \
      gnome-keyring libsecret-tools dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

# Node LTS (necessario para os CLIs dos agentes)
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# CLIs dos agentes
RUN npm install -g @anthropic-ai/claude-code @openai/codex \
    && npm cache clean --force

# gh CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/githubcli.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# usuario nao-root
RUN useradd -m -u 1000 -s /bin/bash agent \
    && install -d -o agent -g agent /home/agent/workspace

# mise para o agente
USER agent
RUN curl -fsSL https://mise.run | sh
ENV PATH="/home/agent/.local/bin:/home/agent/.local/share/mise/shims:${PATH}"
# Antigravity CLI substitui o Gemini CLI, descontinuado em 2026-06-18 para
# contas Pro/Ultra. E um binario Go unico; nao ha pacote npm.
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash
USER root

# HOST KEYS ASSADAS NO BUILD — nao gerar em runtime.
# Containers efemeros reusam portas em 127.0.0.1; chave por container
# dispararia host-key-changed a cada workspace.
RUN ssh-keygen -A && mkdir -p /run/sshd

# sshd: so chave publica, sem senha, sem root
RUN printf '%s\n' \
      'PermitRootLogin no' \
      'PasswordAuthentication no' \
      'PubkeyAuthentication yes' \
      'AuthorizedKeysFile /home/agent/.ssh/authorized_keys' \
      'AcceptEnv HTTPS_PROXY HTTP_PROXY NO_PROXY' \
      > /etc/ssh/sshd_config.d/agent-sandbox.conf

# Aninhamento: cada agente tenta se sandboxar dentro do container e conflita.
# O container E a fronteira; ver spec 3.6.
# NAO definir CLAUDE_CODE_SUBPROCESS_ENV_SCRUB aqui. Ela veio do spec original,
# onde protegia subprocessos NO HOST. Dentro do container ela nao protege nada
# (o container ja e a fronteira) e o Claude Code responde a ela forcando o
# permission mode para default — anulando o --dangerously-skip-permissions que
# o Orca aplica, que e justamente a capacidade que o sandbox existe para
# viabilizar com seguranca.

# Marcador que o guarda asb-agent procura para saber que esta DENTRO do
# sandbox. Sua ausencia no host e o que faz o guarda recusar la.
RUN printf 'agent-sandbox\n' > /etc/agent-sandbox-release

# O mesmo guarda vai nos dois lados: o campo "Command" do Orca e global, entao
# o nome precisa existir tambem dentro da imagem — aqui ele e transparente.
COPY asb-agent /usr/local/bin/asb-agent
COPY install-config.py /usr/local/bin/asb-install-config
RUN chmod 0755 /usr/local/bin/asb-agent \
    /usr/local/bin/asb-install-config \
    && for a in claude codex agy; do ln -sf /usr/local/bin/asb-agent "/usr/local/bin/asb-$a"; done

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY start-keyring.sh /usr/local/bin/start-keyring.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/start-keyring.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
