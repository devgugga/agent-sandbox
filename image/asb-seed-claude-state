#!/usr/bin/env python3
"""image/asb-seed-claude-state — semeia a flag de primeira execucao do Claude.

O Claude Code guarda o login em `~/.claude/.credentials.json` (volume
compartilhado entre workspaces), mas o "onboarding ja feito" em
`~/.claude.json`, que fica na camada gravavel de CADA container. Num workspace
novo a flag falta e o Claude abre "Select login method" mesmo com a credencial
valida.

Este helper toca SO `hasCompletedOnboarding` em `$HOME/.claude.json`:
  - ausente: cria o arquivo com a flag, modo 0600;
  - objeto JSON com a flag ja true: nao reescreve;
  - objeto JSON sem a flag, ou com ela false: liga a flag, preserva todas as
    outras chaves, troca atomica (temporario no mesmo diretorio, fsync,
    rename), modo 0600;
  - qualquer outra coisa (symlink, diretorio, FIFO, ilegivel, JSON invalido,
    nao-objeto): deixa intocado e avisa uma vez no stderr.
Nunca le nem escreve em `~/.claude/` (a credencial). Sai 0 SEMPRE: um problema
aqui nao pode impedir o container de subir. Roda como o usuario comum, chamado
pelo entrypoint.
"""
import json
import os
import stat
import sys
import tempfile

FLAG = "hasCompletedOnboarding"


def warn(path: str, why: str) -> None:
    print(f"asb-seed-claude-state: {path} deixado intacto: {why}", file=sys.stderr)


def write_atomic(path: str, data: dict, *, replace: bool) -> None:
    """Grava ao lado e troca por rename. Sem `replace`, usa link(2), que
    falha se o destino surgiu no meio do caminho em vez de sobrescreve-lo."""
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=".claude.json.asb-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            os.fchmod(fh.fileno(), 0o600)
            fh.write(json.dumps(data, ensure_ascii=False,
                                indent=2 if replace else None))
            fh.flush()
            os.fsync(fh.fileno())
        if replace:
            os.replace(tmp, path)
        else:
            os.link(tmp, path)
            os.unlink(tmp)
        tmp = None
        dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except FileNotFoundError:
                pass


def seed(path: str) -> None:
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        write_atomic(path, {FLAG: True}, replace=False)
        return
    if not stat.S_ISREG(st.st_mode):
        warn(path, "nao e um arquivo regular")
        return
    try:
        # O_NOFOLLOW e O_NONBLOCK: se o arquivo virou symlink ou FIFO entre o
        # lstat e o open, falhar em vez de seguir ou travar a partida.
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as fh:
            if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
                warn(path, "nao e um arquivo regular")
                return
            raw = fh.read()
        data = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, ValueError) as exc:
        warn(path, f"ilegivel ou JSON invalido ({type(exc).__name__})")
        return
    if not isinstance(data, dict):
        warn(path, "o JSON nao e um objeto")
        return
    if data.get(FLAG) is True:
        return
    data[FLAG] = True
    write_atomic(path, data, replace=True)


def main() -> int:
    home = os.environ.get("HOME", "")
    path = os.path.join(home, ".claude.json")
    if not home or not os.path.isabs(home):
        warn(path, "HOME ausente ou relativo")
        return 0
    try:
        seed(path)
    except Exception as exc:  # noqa: BLE001 — a partida nunca depende disto
        warn(path, f"falha inesperada ({type(exc).__name__}: {exc})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
